# =====================================================================
#  Server tuning - edit values here, then run: ./manage.sh restart
#  (or open this file with: ./manage.sh tune)
#
#  Keep comments on their own lines: no inline "# ..." after values.
# =====================================================================

# --- JVM -------------------------------------------------------------

# Java heap size. 4G-6G for a small modded server.
# Leave at least 2G free for the host OS.
MEMORY_SIZE=4G

# Aikar's GC flags: fewer "garbage collection" freezes.
# false = plain -XX:+UseG1GC
USE_AIKAR_FLAGS=true

# --- server.properties overrides --------------------------------------
# These are written into server-data/server.properties on EVERY boot,
# overriding whatever is there. Leave a value empty (e.g. VIEW_DISTANCE=)
# to stop enforcing it and manage it with ./manage.sh edit instead.

# Chunks sent to players (vanilla default: 10).
VIEW_DISTANCE=7

# Chunks around players where mobs, redstone, crops... are ticked
# (vanilla default: 10). Biggest CPU lever.
SIMULATION_DISTANCE=5

# % of the default distance at which entities are sent to clients (10-1000).
ENTITY_BROADCAST_RANGE=75

# false = save chunks asynchronously (fewer disk stalls on the main thread).
SYNC_CHUNK_WRITES=false

# Packets bigger than this (bytes) get compressed. -1 disables compression.
NETWORK_COMPRESSION_THRESHOLD=256

# Watchdog: kill the server if one tick takes longer than this (ms). -1 disables.
MAX_TICK_TIME=60000

# --- Extra server-side mods -------------------------------------------
# Modrinth slugs (space separated), downloaded after the modpack install
# for the pack's Minecraft version. Skipped if already in the pack.
# Leave empty to install none.
#   lithium     - general server tick optimisation
#   ferrite-core - lower RAM usage
#   chunky      - world pre-generation (chunky radius 5000 / chunky start)
#   spark       - profiler (spark tps / spark profiler start|stop)
#   servercore  - entity activation range & other server-side optimisations
EXTRA_MODS=lithium ferrite-core chunky spark servercore
